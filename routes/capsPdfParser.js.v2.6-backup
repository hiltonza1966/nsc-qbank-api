/**
 * Generic CAPS PDF Parser — routes/capsPdfParser.js (v2.6 FINAL)
 * Fixed: Concatenates lines before splitting names (handles multi-line names)
 * Fixed: Smart mark extraction from concatenated digit strings
 * Fixed: Weighting extraction from numbers before parentheses
 */

const pdf = require('pdf-parse');
const fs = require('fs');
const path = require('path');

const CAPS_WEIGHTINGS = {
  10: { sba: 25, exam: 75, external: null, trial: null },
  11: { sba: 25, exam: 75, external: null, trial: null },
  12: { sba: 25, exam: null, external: 50, trial: 25 },
};

const VALID_CAPS_MARKS = new Set([50, 100, 150, 200]);

const ASSESSMENT_TYPES = [
  { type: 'trial_examination', regex: /trial\s+examination/i, is_exam: true, is_practical: false },
  { type: 'midyear_examination', regex: /mid[-\s]?year\s+examination/i, is_exam: true, is_practical: false },
  { type: 'end_of_year_examination', regex: /end[-\s]?of[-\s]?year\s+examination/i, is_exam: true, is_practical: false },
  { type: 'practical_examination', regex: /practical\s+examination/i, is_exam: false, is_practical: true },
  { type: 'practical_task', regex: /practical\s+task/i, is_exam: false, is_practical: true },
  { type: 'control_test', regex: /control\s+test/i, is_exam: false, is_practical: false },
  { type: 'written_report', regex: /written\s+report/i, is_exam: false, is_practical: false },
  { type: 'case_study', regex: /case\s+study/i, is_exam: false, is_practical: false },
  { type: 'presentation', regex: /presentation/i, is_exam: false, is_practical: false },
  { type: 'project', regex: /project/i, is_exam: false, is_practical: false },
  { type: 'assignment', regex: /assignment/i, is_exam: false, is_practical: false },
  { type: 'fieldwork', regex: /fieldwork/i, is_exam: false, is_practical: false },
  { type: 'oral', regex: /oral\b/i, is_exam: false, is_practical: false },
  { type: 'test', regex: /test\b/i, is_exam: false, is_practical: false },
  { type: 'examination', regex: /examination\b/i, is_exam: true, is_practical: false },
  { type: 'data_handling', regex: /data\s+handling/i, is_exam: false, is_practical: false },
  { type: 'mapwork_task', regex: /mapwork\s+task/i, is_exam: false, is_practical: false },
  { type: 'research_task', regex: /research\s+task/i, is_exam: false, is_practical: false },
];

const SUBJECT_CORRUPTION_FIXES = {
  'IFE SCIENCES': 'LIFE SCIENCES',
  'IFE SCIENCE': 'LIFE SCIENCES',
  'CCOUNTING': 'ACCOUNTING',
  'CCOUNTIN': 'ACCOUNTING',
  'ATHEMATICS': 'MATHEMATICS',
  'HYSICAL SCIENCES': 'PHYSICAL SCIENCES',
  'EOGRAPHY': 'GEOGRAPHY',
  'ISTORY': 'HISTORY',
  'CONOMICS': 'ECONOMICS',
  'USINESS STUDIES': 'BUSINESS STUDIES',
  'OMPUTER APPLICATIONS TECHNOLOGY': 'COMPUTER APPLICATIONS TECHNOLOGY',
  'NFORMATION TECHNOLOGY': 'INFORMATION TECHNOLOGY',
  'GRICULTURAL SCIENCES': 'AGRICULTURAL SCIENCES',
  'ONSUMER STUDIES': 'CONSUMER STUDIES',
  'IFE ORIENTATION': 'LIFE ORIENTATION',
  'ELIGION STUDIES': 'RELIGION STUDIES',
  'RAMATIC ARTS': 'DRAMATIC ARTS',
  'ISUAL ARTS': 'VISUAL ARTS',
  'USIC': 'MUSIC',
  'ANCE STUDIES': 'DANCE STUDIES',
  'ESIGN': 'DESIGN',
  'OURISM': 'TOURISM',
  'OSPITALITY STUDIES': 'HOSPITALITY STUDIES',
};

class CapsPdfParser {
  constructor() {
    this.rawText = '';
    this.lines = [];
    this.subjectName = null;
    this.subjectCode = null;
    this.documentType = null;
  }

  async parse(pdfPath) {
    const dataBuffer = fs.readFileSync(pdfPath);
    const pdfData = await pdf(dataBuffer);
    this.rawText = pdfData.text;
    this.lines = this.rawText.split('\n').map(l => l.trim()).filter(l => l.length > 0);

    this._detectSubject();
    this._detectDocumentType();

    let result;
    switch (this.documentType) {
      case 'annual_teaching_plan':
        result = this._parseAnnualTeachingPlan();
        break;
      case 'programmes_of_assessment':
        result = this._parseProgrammesOfAssessment();
        break;
      case 'recording_reporting':
        result = this._parseRecordingAndReporting();
        break;
      case 'assessment_programme':
      default:
        result = this._parseAssessmentProgramme();
        break;
    }

    return {
      ...result,
      subject_name: this.subjectName,
      subject_official_code: this.subjectCode,
      source_document: path.basename(pdfPath),
      extracted_at: new Date().toISOString(),
      parser_version: '2.6.0',
      document_type: this.documentType
    };
  }

  // ============================================================================
  // DOCUMENT TYPE DETECTION
  // ============================================================================

  _detectDocumentType() {
    const firstPage = this.rawText.substring(0, 3000).toLowerCase();
    const fullText = this.rawText.substring(0, 8000).toLowerCase();

    if (firstPage.includes('annual teaching plan') || 
        firstPage.includes('atp') || 
        firstPage.includes('annualteachingplan') ||
        firstPage.includes('work schedule')) {
      this.documentType = 'annual_teaching_plan';
      return;
    }

    if (fullText.includes('programmes of assessment') && 
        (fullText.includes('promotion') || fullText.includes('requirements'))) {
      this.documentType = 'programmes_of_assessment';
      return;
    }

    if (fullText.includes('recording') && 
        fullText.includes('reporting') && 
        fullText.includes('code of conduct')) {
      this.documentType = 'recording_reporting';
      return;
    }

    const section4Text = this._extractSection4();
    if (section4Text) {
      this.documentType = 'assessment_programme';
      return;
    }

    if (/Grade\s*10.*Programme.*Term.*assessment/is.test(this.rawText) ||
        /GRADE\s*10.*PROGRAMME.*Term.*assessment/is.test(this.rawText)) {
      this.documentType = 'assessment_programme';
      return;
    }

    this.documentType = 'assessment_programme';
  }

  // ============================================================================
  // SUBJECT DETECTION (FIXED for multi-line headers)
  // ============================================================================

  _detectSubject() {
    for (let i = 0; i < Math.min(50, this.lines.length); i++) {
      const line = this.lines[i];

      // Pattern 1: Subject on same line as GRADES
      const sameLineMatch = line.match(/^([A-Z][A-Z\s]+)\s+GRADES\s+10[-–]12/i);
      if (sameLineMatch && sameLineMatch[1].length > 3) {
        this.subjectName = sameLineMatch[1].trim().replace(/\s+/g, ' ');
        break;
      }

      // Pattern 2: Subject on previous line, GRADES on current line
      if (line === 'GRADES 10-12' && i > 0) {
        const prevLine = this.lines[i - 1];
        if (prevLine.match(/^[A-Z][A-Z\s]+$/)) {
          this.subjectName = prevLine.trim().replace(/\s+/g, ' ');
          break;
        }
      }

      // Pattern 3: Single-word subject followed by GRADES
      if (line.match(/^[A-Z]+$/) && i + 1 < this.lines.length) {
        if (this.lines[i + 1].startsWith('GRADES')) {
          this.subjectName = line.trim();
          break;
        }
      }
    }

    if (this.subjectName) {
      const upperName = this.subjectName.toUpperCase();
      for (const [corrupted, fixed] of Object.entries(SUBJECT_CORRUPTION_FIXES)) {
        if (upperName === corrupted || upperName.includes(corrupted)) {
          this.subjectName = fixed;
          break;
        }
      }
    }

    if (!this.subjectName) {
      const subjects = [
        'LIFE SCIENCES', 'ACCOUNTING', 'MATHEMATICS', 'PHYSICAL SCIENCES',
        'GEOGRAPHY', 'HISTORY', 'ECONOMICS', 'BUSINESS STUDIES',
        'ENGLISH HOME LANGUAGE', 'AFRIKAANS', 'ISIZULU', 'ISIXHOSA',
        'CONSUMER STUDIES', 'AGRICULTURAL SCIENCES', 'COMPUTER APPLICATIONS TECHNOLOGY',
        'INFORMATION TECHNOLOGY', 'TOURISM', 'HOSPITALITY STUDIES',
        'DRAMATIC ARTS', 'VISUAL ARTS', 'MUSIC', 'DANCE STUDIES',
        'DESIGN', 'LIFE ORIENTATION', 'RELIGION STUDIES'
      ];
      const headerText = this.lines.slice(0, 50).join(' ').toUpperCase();
      for (const subj of subjects) {
        if (headerText.includes(subj)) {
          this.subjectName = subj;
          break;
        }
      }
    }
  }

  // ============================================================================
  // SECTION 4 EXTRACTION
  // ============================================================================

  _extractSection4() {
    const fullText = this.rawText;
    const patterns = [
      /SECTION\s+4/i,
      /4\.4\s+Programme\s+of\s+Assessment/i,
      /Assessment\s+in\s+/i,
      /PROGRAMME\s+OF\s+ASSESSMENT/i,
    ];

    let startIdx = -1;
    for (const pattern of patterns) {
      const match = fullText.search(pattern);
      if (match !== -1) {
        startIdx = match;
        break;
      }
    }

    if (startIdx === -1) {
      const fallbackPatterns = [
        /Programme\s+of\s+(?:Formal\s+)?Assessment/i,
        /GRADE\s+10\s+PROGRAMME/i,
        /Grade\s+10\s+Programme\s+of\s+Assessment/i,
      ];
      for (const pattern of fallbackPatterns) {
        const match = fullText.search(pattern);
        if (match !== -1) {
          startIdx = match;
          break;
        }
      }
    }

    if (startIdx === -1) return null;

    const endPatterns = [
      /SECTION\s+5[:\.]?\s*/i,
      /4\.8\s+General/i,
      /4\.7\s+Moderation/i,
      /ANNEXURE/i,
      /GLOSSARY/i,
      /SECTION\s+5/i,
    ];

    const lastGradeMatch = fullText.search(/GRADE\s+12\s+PROGRAMME/i);
    const minEndPos = lastGradeMatch !== -1 ? lastGradeMatch + 5000 : startIdx + 10000;

    let endIdx = fullText.length;
    for (const pattern of endPatterns) {
      const regex = new RegExp(pattern.source, 'gi');
      let match;
      let lastMatch = -1;
      while ((match = regex.exec(fullText)) !== null) {
        if (match.index > startIdx && match.index > minEndPos) {
          lastMatch = match.index;
        }
      }
      if (lastMatch !== -1) {
        endIdx = Math.min(endIdx, lastMatch);
      }
    }

    return fullText.substring(startIdx, endIdx);
  }

  // ============================================================================
  // ASSESSMENT PROGRAMME PARSER (HYBRID v2.6)
  // ============================================================================

  _parseAssessmentProgramme() {
    const section4Text = this._extractSection4();
    let grades = [];

    if (section4Text) {
      grades = this._parseGradeBlocks(section4Text);
    }

    if (grades.length === 0) {
      grades = this._parseGradeBlocksFromFullText();
    }

    return { grades: grades };
  }

  _parseGradeBlocks(sectionText) {
    const grades = [];
    const gradeNumbers = [10, 11, 12];

    for (const gradeNum of gradeNumbers) {
      const gradeBlock = this._extractGradeBlock(sectionText, gradeNum);
      if (gradeBlock) {
        const gradeData = this._parseSingleGrade(gradeBlock, gradeNum);
        if (gradeData.assessments.length > 0) {
          grades.push(gradeData);
        }
      }
    }

    return grades;
  }

  _extractGradeBlock(text, gradeNum) {
    const allMatches = [];

    const primaryPattern = new RegExp(`the\s+Programme\s+of\s+(?:Formal\s+)?Assessment\s+in\s+Grade\s+${gradeNum}`, 'gi');
    let primaryMatch;
    while ((primaryMatch = primaryPattern.exec(text)) !== null) {
      allMatches.push(primaryMatch.index);
    }

    const capsPattern = new RegExp(`GRADE\s+${gradeNum}\s+PROGRAMME`, 'gi');
    let capsMatch;
    while ((capsMatch = capsPattern.exec(text)) !== null) {
      allMatches.push(capsMatch.index);
    }

    const titlePattern = new RegExp(`Grade\s+${gradeNum}\s*[:\.]?\s*Programme\s+of\s+(?:Formal\s+)?Assessment`, 'gi');
    let titleMatch;
    while ((titleMatch = titlePattern.exec(text)) !== null) {
      allMatches.push(titleMatch.index);
    }

    if (allMatches.length === 0) return null;

    allMatches.sort((a, b) => a - b);
    const startIdx = allMatches[allMatches.length - 1];

    const nextGrade = gradeNum + 1;
    const endPatterns = [
      new RegExp(`the\s+Programme\s+of\s+(?:Formal\s+)?Assessment\s+in\s+Grade\s+${nextGrade}`, 'i'),
      new RegExp(`GRADE\s+${nextGrade}\s+PROGRAMME`, 'i'),
      new RegExp(`Grade\s+${nextGrade}\s*[:\.]?\s*Programme`, 'i'),
      /4\.5\s+End-of-year/i,
      /4\.6\s+Recording/i,
      /4\.7\s+Moderation/i,
    ];

    let endIdx = text.length;
    for (const pattern of endPatterns) {
      const regex = new RegExp(pattern.source, 'i');
      const match = text.search(regex);
      if (match !== -1 && match > startIdx) {
        endIdx = Math.min(endIdx, match);
      }
    }

    const block = text.substring(startIdx, endIdx);

    const hasTerm = /Term\s*\d/i.test(block);
    const hasTest = /test\b/i.test(block);
    const hasExam = /examination\b/i.test(block);
    const hasAssessment = /assessment\b/i.test(block);
    const hasMarks = /\d{2,3}/.test(block);

    if (!hasTerm && !hasTest && !hasExam && !hasAssessment && !hasMarks) {
      return null;
    }

    return block;
  }

  _parseSingleGrade(gradeBlock, gradeNum) {
    const weightConfig = CAPS_WEIGHTINGS[gradeNum];

    // Extract assessment names (concatenate lines first)
    const names = this._extractAssessmentNames(gradeBlock);
    if (!names || names.length === 0) {
      return { grade_value: gradeNum, assessments: [], ...weightConfig };
    }

    // Extract marks from concatenated digit strings
    const marks = this._extractMarksSmart(gradeBlock, names.length);

    // Extract weightings
    const weightings = this._extractWeightings(gradeBlock, names.length);

    // Build assessments
    const assessments = [];
    for (let i = 0; i < names.length; i++) {
      const name = names[i];
      const term = (i % 4) + 1;
      const rawMark = marks[i] || this._guessMark(name);
      const weight = weightings[i] || this._calculateWeighting(rawMark, gradeNum);

      const typeInfo = this._determineAssessmentType(name);

      assessments.push({
        assessment_type: typeInfo.type,
        assessment_name: name,
        term: term.toString(),
        raw_marks: rawMark,
        weighting_percent: weight,
        duration_hours: null,
        is_examination: typeInfo.is_exam,
        is_formal: true,
        is_practical: typeInfo.is_practical,
        is_compulsory: true
      });
    }

    return {
      grade_value: gradeNum,
      sba_weighting: weightConfig.sba,
      exam_weighting: weightConfig.exam,
      external_weighting: weightConfig.external,
      trial_weighting: weightConfig.trial,
      assessments: assessments
    };
  }

  // ============================================================================
  // NAME EXTRACTION (FIXED - concatenate lines before splitting)
  // ============================================================================

  _extractAssessmentNames(gradeBlock) {
    const lines = gradeBlock.split('\n').map(l => l.trim()).filter(l => l.length > 0);
    const nameLines = [];
    let inNames = false;

    for (const line of lines) {
      if (line.match(/^Assessment\s*$/i)) {
        inNames = true;
        continue;
      }

      if (inNames) {
        if (line.match(/^Total\s*marks/i)) {
          break;
        }
        if (line.match(/^term\s*\d/i)) {
          continue;
        }
        nameLines.push(line);
      }
    }

    // Concatenate all name lines with spaces, then split
    const concatenated = nameLines.join(' ');
    const names = this._splitConcatenatedNames(concatenated);
    return names;
  }

  _splitConcatenatedNames(text) {
    const knownTypes = [
      'mid-year examination', 'end-of-year examination', 'trial examination',
      'practical examination', 'practical task', 'control test',
      'written report', 'case study', 'presentation', 'project',
      'assignment', 'fieldwork', 'oral', 'test', 'examination',
      'data handling', 'mapwork task', 'research task'
    ];

    const names = [];
    let remaining = text.toLowerCase().trim();

    while (remaining.length > 0) {
      let matched = false;
      for (const typeName of knownTypes.sort((a, b) => b.length - a.length)) {
        if (remaining.startsWith(typeName.toLowerCase())) {
          const formatted = typeName.replace(/\b\w/g, l => l.toUpperCase())
            .replace('-Year', '-year')
            .replace('-Of', '-of');
          names.push(formatted);
          remaining = remaining.substring(typeName.length).trim();
          matched = true;
          break;
        }
      }

      if (!matched) {
        remaining = remaining.substring(1);
      }
    }

    return names.length > 0 ? names : [text.trim()];
  }

  // ============================================================================
  // MARK EXTRACTION (FIXED - scan digit strings for valid CAPS marks)
  // ============================================================================

  _extractMarksSmart(gradeBlock, expectedCount) {
    const lines = gradeBlock.split('\n').map(l => l.trim()).filter(l => l.length > 0);
    let inMarks = false;
    let digitString = '';

    for (const line of lines) {
      if (line.match(/^Total\s*marks/i)) {
        inMarks = true;
        const digits = line.replace(/[^0-9]/g, '');
        digitString += digits;
        continue;
      }

      if (inMarks) {
        if (line.match(/^Convert\s*to/i)) {
          break;
        }
        const digits = line.replace(/[^0-9]/g, '');
        digitString += digits;
      }
    }

    return this._parseDigitString(digitString, expectedCount);
  }

  _parseDigitString(digitString, expectedCount) {
    const marks = [];
    let remaining = digitString;

    while (remaining && marks.length < expectedCount) {
      let found = false;
      for (const length of [3, 2]) {
        if (remaining.length >= length) {
          const num = parseInt(remaining.substring(0, length));
          if (VALID_CAPS_MARKS.has(num)) {
            marks.push(num);
            remaining = remaining.substring(length);
            found = true;
            break;
          }
        }
      }

      if (!found) {
        remaining = remaining.substring(1);
      }
    }

    return marks;
  }

  _guessMark(name) {
    const lowerName = name.toLowerCase();

    if (lowerName.includes('examination') || lowerName.includes('exam')) {
      return 150;
    } else if (lowerName.includes('test')) {
      return 100;
    } else if (lowerName.includes('practical')) {
      return 50;
    } else if (lowerName.includes('assignment')) {
      return 50;
    } else if (lowerName.includes('project')) {
      return 100;
    } else if (lowerName.includes('presentation')) {
      return 50;
    } else if (lowerName.includes('report')) {
      return 50;
    } else if (lowerName.includes('data handling')) {
      return 50;
    } else if (lowerName.includes('mapwork')) {
      return 50;
    } else if (lowerName.includes('research')) {
      return 100;
    }

    return 50;
  }

  _calculateWeighting(mark, gradeNum) {
    if (!mark || mark <= 0) return 0;

    if (mark === 50) return 10;
    if (mark === 100) return 20;
    if (mark === 150) return 75;
    if (mark === 200) return 100;

    if (mark >= 150) {
      return Math.round(mark / 2);
    } else {
      return Math.round(mark / 5);
    }
  }

  // ============================================================================
  // WEIGHTING EXTRACTION
  // ============================================================================

  _extractWeightings(gradeBlock, expectedCount) {
    const lines = gradeBlock.split('\n').map(l => l.trim()).filter(l => l.length > 0);
    let inWeights = false;
    const weightLines = [];

    for (const line of lines) {
      if (line.match(/^Convert\s*to/i)) {
        inWeights = true;
        weightLines.push(line);
        continue;
      }

      if (inWeights) {
        if (line.match(/^the\s+Programme/i) || line.match(/^4\./)) {
          break;
        }
        weightLines.push(line);
      }
    }

    const weightText = weightLines.join(' ');
    const weightings = [];
    const matches = [...weightText.matchAll(/(\d+)\s*\(/g)];
    for (const match of matches) {
      weightings.push(parseInt(match[1]));
    }

    return weightings;
  }

  _determineAssessmentType(name) {
    const lower = name.toLowerCase();

    for (const typeDef of ASSESSMENT_TYPES) {
      const regex = new RegExp(typeDef.regex.source, 'i');
      if (regex.test(lower)) {
        return {
          type: typeDef.type,
          is_exam: typeDef.is_exam,
          is_practical: typeDef.is_practical
        };
      }
    }

    return { type: 'test', is_exam: false, is_practical: false };
  }

  _parseGradeBlocksFromFullText() {
    const grades = [];
    const gradeNumbers = [10, 11, 12];

    for (const gradeNum of gradeNumbers) {
      const gradeBlock = this._extractGradeBlock(this.rawText, gradeNum);
      if (gradeBlock) {
        const gradeData = this._parseSingleGrade(gradeBlock, gradeNum);
        if (gradeData.assessments.length > 0) {
          grades.push(gradeData);
        }
      }
    }

    return grades;
  }

  // ============================================================================
  // OTHER DOCUMENT TYPE PARSERS
  // ============================================================================

  _parseAnnualTeachingPlan() {
    const topics = [];
    const fullText = this.rawText;

    const weekMatches = [...fullText.matchAll(/Week\s*(\d+)[\s:]*([^\n]+)/gi)];

    for (const match of weekMatches) {
      const weekNum = parseInt(match[1]);
      const topicLine = match[2].trim();

      const precedingText = fullText.substring(Math.max(0, match.index - 500), match.index);
      const termMatch = precedingText.match(/Term\s*(\d)/i);
      const term = termMatch ? termMatch[1] : '1';

      topics.push({
        week_number: weekNum,
        topic: topicLine,
        term: term,
        content: null,
        skills: null,
        time_allocation: null,
        assessment_task: null
      });
    }

    return { grades: [{ grade_value: 10, topics: topics }] };
  }

  _parseProgrammesOfAssessment() {
    const programmes = [];
    const fullText = this.rawText;

    const formalMatch = fullText.match(/Formal\s*Assessment[\s\S]*?(?=Informal|Weighting|Promotion|$)/i);
    if (formalMatch) {
      const lines = formalMatch[0].split('\n').map(l => l.trim()).filter(l => l.length > 2);
      for (const line of lines) {
        if (line.match(/^(Task|Assessment|Type)\b/i)) continue;
        const weightMatch = line.match(/(\d+)%?/);
        programmes.push({
          assessment_type: 'formal',
          task_name: line,
          weighting: weightMatch ? parseInt(weightMatch[1]) : null,
          minimum_required: null
        });
      }
    }

    return { grades: [{ grade_value: 10, programmes: programmes }] };
  }

  _parseRecordingAndReporting() {
    const rules = [];
    const fullText = this.rawText;

    const conversionMatch = fullText.match(/Mark\s*conversion[\s\S]*?(?=Recording|Reporting|$)/i);
    if (conversionMatch) {
      const lines = conversionMatch[0].split('\n').map(l => l.trim()).filter(l => l.length > 2);
      for (const line of lines) {
        const rangeMatch = line.match(/(\d+)[\s-]*(\d+)%?/);
        const codeMatch = line.match(/([A-Z]\d?)/);
        rules.push({
          rule_name: 'mark_conversion',
          description: line,
          mark_range: rangeMatch ? `${rangeMatch[1]}-${rangeMatch[2]}` : null,
          report_code: codeMatch ? codeMatch[1] : null
        });
      }
    }

    return { grades: [{ grade_value: 10, rules: rules }] };
  }
}

// ============================================================================
// EXPRESS ROUTES
// ============================================================================

const express = require('express');
const router = express.Router();
const multer = require('multer');
const upload = multer({ dest: 'uploads/' });

router.post('/api/caps/parse-pdf', upload.single('pdf'), async (req, res) => {
  try {
    if (!req.file) {
      return res.status(400).json({ error: 'No PDF file uploaded' });
    }

    const parser = new CapsPdfParser();
    const result = await parser.parse(req.file.path);

    fs.unlinkSync(req.file.path);

    const totalAssessments = result.grades ? result.grades.reduce((sum, g) => sum + (g.assessments ? g.assessments.length : 0), 0) : 0;
    const totalPapers = result.grades ? result.grades.reduce((sum, g) => sum + (g.papers ? g.papers.length : 0), 0) : 0;
    const warnings = [];

    if (!result.subject_name) warnings.push('Subject name not detected');
    if (!result.grades || result.grades.length === 0) warnings.push('No grade blocks found');
    if (totalAssessments === 0) warnings.push('No assessments extracted');

    for (const grade of (result.grades || [])) {
      if (grade.assessments) {
        const uniqueTerms = new Set(grade.assessments.map(a => a.term)).size;
        if (uniqueTerms < 4) {
          warnings.push(`Grade ${grade.grade_value}: Only ${uniqueTerms} unique terms found`);
        }
      }
    }

    res.json({
      success: true,
      parsed: result,
      validation: {
        subject_detected: !!result.subject_name,
        grades_found: result.grades ? result.grades.length : 0,
        total_assessments: totalAssessments,
        total_papers: totalPapers,
        warnings: warnings
      }
    });
  } catch (err) {
    console.error('CAPS PDF Parse Error:', err);
    res.status(500).json({ error: err.message });
  }
});

router.post('/api/caps/seed-assessment', async (req, res) => {
  const { parsed_data } = req.body;
  const db = req.app.locals.db;

  if (!db) {
    return res.status(500).json({ error: 'Database not available' });
  }

  try {
    const results = { inserted: 0, errors: [], warnings: [] };

    let subjectCode = parsed_data.subject_official_code;
    if (!subjectCode) {
      const [subjectRows] = await db.execute(
        'SELECT subject_official_code FROM lookup_subjects WHERE UPPER(subject_name) = UPPER(?)',
        [parsed_data.subject_name]
      );
      if (subjectRows.length > 0) {
        subjectCode = subjectRows[0].subject_official_code;
      } else {
        results.warnings.push(`Subject "${parsed_data.subject_name}" not found in lookup_subjects`);
        subjectCode = 'UNKNOWN';
      }
    }

    const gradeIdMap = { 10: 1, 11: 2, 12: 3 };

    for (const grade of parsed_data.grades) {
      const gradeId = gradeIdMap[grade.grade_value];
      if (!gradeId) {
        results.errors.push(`Invalid grade: ${grade.grade_value}`);
        continue;
      }

      for (const assessment of grade.assessments) {
        try {
          const assessmentName = assessment.assessment_name || 
            assessment.assessment_type.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());

          const weightingPercent = assessment.weighting_percent || 0;
          const totalMarks = assessment.raw_marks || 0;
          const durationHours = assessment.duration_hours || null;
          const paperNumber = assessment.paper_number || null;

          const [insertResult] = await db.execute(
            `INSERT INTO assessment_programme 
             (subject_official_code, grade_id, assessment_type, assessment_name, term, 
              weighting_percent, total_marks, duration_hours, paper_number,
              is_examination, is_formal, is_practical, is_compulsory, 
              source_document, extracted_at, created_at)
             VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, NOW())`,
            [
              subjectCode,
              gradeId,
              assessment.assessment_type.toUpperCase().replace(/\s/g, '_'),
              assessmentName,
              assessment.term,
              weightingPercent,
              totalMarks,
              durationHours,
              paperNumber,
              assessment.is_examination ? 1 : 0,
              assessment.is_formal ? 1 : 0,
              assessment.is_practical ? 1 : 0,
              assessment.is_compulsory ? 1 : 0,
              parsed_data.source_document,
              new Date(parsed_data.extracted_at)
            ]
          );
          results.inserted++;
        } catch (err) {
          results.errors.push(`Grade ${grade.grade_value}, ${assessment.assessment_type}: ${err.message}`);
        }
      }
    }

    res.json({
      success: true,
      seeded: results.inserted,
      warnings: results.warnings,
      errors: results.errors
    });
  } catch (err) {
    console.error('Seed Error:', err);
    res.status(500).json({ error: err.message });
  }
});

router.post('/api/caps/seed-atp', async (req, res) => {
  const { parsed_data } = req.body;
  const db = req.app.locals.db;
  if (!db) return res.status(500).json({ error: 'Database not available' });
  try {
    const results = { inserted: 0, errors: [] };
    let subjectCode = parsed_data.subject_official_code;
    if (!subjectCode) {
      const [subjectRows] = await db.execute('SELECT subject_official_code FROM lookup_subjects WHERE UPPER(subject_name) = UPPER(?)', [parsed_data.subject_name]);
      if (subjectRows.length > 0) subjectCode = subjectRows[0].subject_official_code;
    }
    for (const grade of parsed_data.grades) {
      for (const topic of (grade.topics || [])) {
        try {
          await db.execute(`INSERT INTO annual_teaching_plan (subject_official_code, grade_id, term, week_number, topic, content, skills, time_allocation, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, NOW())`, [subjectCode, grade.grade_value, topic.term, topic.week_number, topic.topic, topic.content, topic.skills, topic.time_allocation]);
          results.inserted++;
        } catch (err) { results.errors.push(err.message); }
      }
    }
    res.json({ success: true, seeded: results.inserted, errors: results.errors });
  } catch (err) { res.status(500).json({ error: err.message }); }
});

