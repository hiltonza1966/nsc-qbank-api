const express = require('express');
const router = express.Router();
const fs = require('fs');
const path = require('path');

const LOG_FILE = path.join(__dirname, '..', 'parser_debug.log');

function log(msg) {
  const timestamp = new Date().toISOString();
  const line = `[${timestamp}] ${msg}\n`;
  fs.appendFileSync(LOG_FILE, line);
  console.log(line.trim());
}

function clearLog() {
  fs.writeFileSync(LOG_FILE, `Parser Debug Log - ${new Date().toISOString()}\n`);
}

/**
 * Parse structured text from pdf.js getTextContent()
 * ATOMIC ITEM EXTRACTION: Groups sub-parts under parent questions
 * 
 * RULE: 
 * - 1.1.1, 1.2.1, 1.3.1 = standalone atomic items (no shared stimulus)
 * - 1.4, 2.1, 3.2 = parent atomic items (sub-parts share stimulus/diagram)
 * - 1.4.1, 2.1.1, 3.2.1 = sub-parts (NOT separate items, stored in parent)
 */
function parseStructuredText(textItems, type, subject, paperNo) {
  clearLog();
  log(`=== PARSER START (Atomic Items - v2) ===`);
  log(`Input: ${textItems.length} text items`);

  // Step 1: Sort items by page, then y (descending), then x (ascending)
  const sorted = [...textItems].sort((a, b) => {
    if (a.page !== b.page) return a.page - b.page;
    if (Math.abs(a.y - b.y) > 5) return b.y - a.y;
    return a.x - b.x;
  });

  // Step 2: Group items into lines by y-position proximity
  const lines = [];
  let currentLine = [];
  let currentY = null;

  for (const item of sorted) {
    if (currentY === null || Math.abs(item.y - currentY) < 5) {
      currentLine.push(item);
      currentY = item.y;
    } else {
      if (currentLine.length > 0) {
        currentLine.sort((a, b) => a.x - b.x);
        const lineText = currentLine.map(i => i.text).join(' ');
        lines.push({
          text: lineText,
          y: currentY,
          page: currentLine[0].page,
          items: currentLine
        });
      }
      currentLine = [item];
      currentY = item.y;
    }
  }
  if (currentLine.length > 0) {
    currentLine.sort((a, b) => a.x - b.x);
    const lineText = currentLine.map(i => i.text).join(' ');
    lines.push({
      text: lineText,
      y: currentY,
      page: currentLine[0].page,
      items: currentLine
    });
  }

  log(`Grouped into ${lines.length} lines`);

  // Step 3: First pass - identify all lines with question numbers
  const detectedLines = [];
  let currentSection = 'Section A';

  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    const text = line.text.trim();

    // Detect section headers
    const sectionMatch = text.match(/SECTION\s+([A-Z])/i);
    if (sectionMatch) {
      currentSection = 'Section ' + sectionMatch[1];
      log(`>>> SECTION: ${currentSection}`);
      continue;
    }

    // Detect Question 2 / Question 3 headers
    if (text.match(/QUESTION\s*2/i)) {
      log(`>>> QUESTION 2`);
      continue;
    }
    if (text.match(/QUESTION\s*3/i)) {
      log(`>>> QUESTION 3`);
      continue;
    }

    // Detect sub-part questions: 1.1.1, 1.2.1, 1.3.1, 1.4.1, 2.1.1, 3.2.1 etc.
    const subPartMatch = text.match(/^(\d+\.\d+\.\d+)\s*(.*)/);
    if (subPartMatch) {
      detectedLines.push({
        type: 'sub_part',
        number: subPartMatch[1],
        text: subPartMatch[2],
        section: currentSection,
        lineIndex: i
      });
      continue;
    }

    // Detect parent questions: 1.1, 1.2, 1.3, 1.4, 2.1, 3.2 etc.
    const parentMatch = text.match(/^(\d+\.\d+)\s+(.+)/);
    if (parentMatch) {
      detectedLines.push({
        type: 'parent',
        number: parentMatch[1],
        text: parentMatch[2],
        section: currentSection,
        lineIndex: i
      });
    }
  }

  log(`Detected ${detectedLines.length} question lines`);

  // Step 4: Group sub-parts under parents
  // Rule: 
  // - 1.1.x, 1.2.x, 1.3.x = standalone (no parent text, just sub-parts)
  // - 1.4.x, 2.1.x, 3.2.x = grouped under parent (parent has stimulus text)
  const parents = {};
  const standaloneSubParts = {};
  const orphanedSubParts = [];

  for (const dl of detectedLines) {
    if (dl.type === 'parent') {
      parents[dl.number] = {
        text: dl.text,
        section: dl.section,
        subParts: [],
        lineIndex: dl.lineIndex
      };
    } else if (dl.type === 'sub_part') {
      const parts = dl.number.split('.');
      const parentNum = parts[0] + '.' + parts[1];
      
      if (parents[parentNum]) {
        // This sub-part belongs to a detected parent
        parents[parentNum].subParts.push({
          number: dl.number,
          text: dl.text,
          section: dl.section
        });
      } else {
        // No parent detected - this is a standalone sub-part
        // (e.g., 1.1.1, 1.2.1, 1.3.1 which have no parent text)
        if (!standaloneSubParts[parentNum]) {
          standaloneSubParts[parentNum] = [];
        }
        standaloneSubParts[parentNum].push({
          number: dl.number,
          text: dl.text,
          section: dl.section
        });
      }
    }
  }

  // Step 5: Build atomic items
  const atomicItems = [];
  let sequence = 1;

  // 5a: Add standalone sub-parts as individual items (1.1.1, 1.2.1, 1.3.1)
  for (const [parentNum, subParts] of Object.entries(standaloneSubParts)) {
    const parts = parentNum.split('.');
    
    for (const sp of subParts) {
      let itemType = 'Extended';
      if (parts[0] === '1') {
        if (parts[1] === '1') itemType = 'MCQ';
        else if (parts[1] === '2') itemType = 'Short';
        else if (parts[1] === '3') itemType = 'Matching';
        else itemType = 'Diagram';
      }

      atomicItems.push({
        question_number: sp.number,
        question_text: sp.text,
        marks: 0,
        section: sp.section,
        type: itemType,
        sequence: sequence++,
        images: [],
        parent: null,
        sub_parts: [],
        has_sub_parts: false,
        is_standalone: true
      });
      
      log(`  STANDALONE ITEM ${sp.number} | ${itemType} | ${sp.section}`);
    }
  }

  // 5b: Add parent items with grouped sub-parts (1.4, 2.1, 3.2)
  for (const [parentNum, parentInfo] of Object.entries(parents)) {
    const parts = parentNum.split('.');
    
    let itemType = 'Extended';
    if (parts[0] === '1') {
      if (parts[1] === '1') itemType = 'MCQ';
      else if (parts[1] === '2') itemType = 'Short';
      else if (parts[1] === '3') itemType = 'Matching';
      else itemType = 'Diagram';
    }

    // Build full text: parent text + sub-parts
    let fullText = parentInfo.text;
    if (parentInfo.subParts.length > 0) {
      fullText += '\\n\\nSub-parts:\\n';
      for (const sp of parentInfo.subParts.sort((a, b) => a.number.localeCompare(b.number))) {
        fullText += `[${sp.number}] ${sp.text}\\n`;
      }
    }

    atomicItems.push({
      question_number: parentNum,
      question_text: fullText,
      marks: 0,
      section: parentInfo.section,
      type: itemType,
      sequence: sequence++,
      images: [],
      parent: null,
      sub_parts: parentInfo.subParts.map(sp => sp.number),
      has_sub_parts: parentInfo.subParts.length > 0,
      is_standalone: false
    });

    log(`  PARENT ITEM ${parentNum} | ${itemType} | ${parentInfo.section} | ${parentInfo.subParts.length} sub-parts`);
  }

  // Sort by sequence to maintain order
  atomicItems.sort((a, b) => a.sequence - b.sequence);
  
  // Re-assign sequence after sorting
  sequence = 1;
  for (const item of atomicItems) {
    item.sequence = sequence++;
  }

  log(`\n=== ATOMIC ITEMS: ${atomicItems.length} ===`);
  log(`  Standalone: ${atomicItems.filter(i => i.is_standalone).length}`);
  log(`  Parent (grouped): ${atomicItems.filter(i => !i.is_standalone).length}`);
  log(`  Section A: ${atomicItems.filter(i => i.section === 'Section A').length}`);
  log(`  Section B: ${atomicItems.filter(i => i.section === 'Section B').length}`);
  log(`  Section C: ${atomicItems.filter(i => i.section === 'Section C').length}`);
  log(`=== PARSER END ===\n`);

  return atomicItems;
}

// ============================================
// ROUTE: POST /api/wizard/parse
// ============================================
router.post('/parse', (req, res) => {
  try {
    const { textItems, type, subject, paper_no } = req.body;
    
    if (!Array.isArray(textItems)) {
      return res.status(400).json({ error: 'textItems array required' });
    }

    const questions = parseStructuredText(textItems, type || 'QP', subject, paper_no);
    
    res.json({
      success: true,
      questions: questions,
      total_items: questions.length,
      expected_items: 33,  // Life Sciences P1 Nov 2025
      expected_marks: 150,
      note: 'Atomic items: parent questions with sub-parts are single items. Sub-parts stored as JSON.'
    });

  } catch (error) {
    console.error('Parse error:', error);
    res.status(500).json({ error: error.message });
  }
});

// ============================================
// ROUTE: POST /api/wizard/extract-structure
// ============================================
router.post('/extract-structure', async (req, res) => {
  const conn = await req.db.getConnection();
  
  try {
    const { textItems, paper_code, subject_name, paper_no, exam_year, exam_session } = req.body;
    
    if (!Array.isArray(textItems) || !paper_code) {
      return res.status(400).json({ error: 'textItems and paper_code required' });
    }

    const questions = parseStructuredText(textItems, 'QP', subject_name, paper_no);
    
    await conn.beginTransaction();

    // Clear existing structure for this paper
    await conn.execute(
      'DELETE FROM QB_questionP_Structure WHERE paper_code = ?',
      [paper_code]
    );

    // Insert atomic items
    let sequence = 1;
    for (const q of questions) {
      await conn.execute(
        `INSERT INTO QB_questionP_Structure 
         (paper_code, subject_name, paper_no, exam_year, exam_session, 
          question_number, question_type, section, expected_marks, sequence, 
          parent_question, is_sub_part, sub_parts_json)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
        [
          paper_code, subject_name, paper_no, exam_year, exam_session,
          q.question_number, q.type, q.section, 0, sequence++,
          null, false, JSON.stringify(q.sub_parts || [])
        ]
      );
    }

    await conn.commit();

    res.json({
      success: true,
      total_items: questions.length,
      total_marks: 0,
      expected_items: 33,
      expected_marks: 150,
      message: 'Atomic structure extracted. 33 items expected for Life Sciences P1. Marks set to 0 - use ReviewPanel to correct.'
    });

  } catch (error) {
    await conn.rollback();
    console.error('Extract structure error:', error);
    res.status(500).json({ error: error.message });
  } finally {
    conn.release();
  }
});

module.exports = router;
