const express = require('express');
const router = express.Router();
const db = require('../../backend/db');

// ============================================================
// QP & MEMO REGISTER - SURGICAL FIX v36
// Date: 2026-06-26
// Changes:
// 1. Removed server-side filtering - returns ALL data
// 2. Derives filter options from actual data (not lookup tables)
// 3. Database source query fixed for empty tables
// 4. Paper code parsing: SUBJ_P#_YYYY_SESSION_LANG
// 5. Fixed column names: assessment_type_id, assessment_body_id, body_full_name
// 6. Restructured SQL to avoid GROUP BY / ONLY_FULL_GROUP_BY issues
// 7. JOIN on ps.subject_id = ls.subject_id (correct column)
// ============================================================

// Helper: Parse paper code into components
function parsePaperCode(paperCode) {
  if (!paperCode) return null;
  const parts = paperCode.split('_');
  if (parts.length < 5) return null;
  return {
    subject_code: parts[0],
    paper_no: parts[1],
    year: parts[2],
    session: parts[3],
    language: parts[4]
  };
}

// GET /api/v2/ - Main register endpoint
router.get('/', async (req, res) => {
  try {
    const source = req.query.source || 'parsed'; // 'parsed' or 'database'

    if (source === 'parsed') {
      return await getParsedData(req, res);
    } else {
      return await getDatabaseData(req, res);
    }
  } catch (error) {
    console.error('QP Memo Register Error:', error);
    res.status(500).json({ error: 'Failed to fetch register data', details: error.message });
  }
});

// ============================================================
// PARSED DATA - Returns ALL data, no server-side filtering
// JOIN on ps.subject_id = ls.subject_id (correct)
// ============================================================
async function getParsedData(req, res) {
  const connection = await db.getConnection();

  try {
    // Step 1: Get all distinct paper codes from parse_results (QP)
    const [qpPaperCodes] = await connection.execute(`
      SELECT DISTINCT paper_code FROM parse_results 
      WHERE is_memo = 0 OR is_memo IS NULL
      ORDER BY paper_code
    `);

    // Step 2: Get all distinct paper codes from parse_memos
    const [memoPaperCodes] = await connection.execute(`
      SELECT DISTINCT paper_code FROM parse_memos 
      ORDER BY paper_code
    `);

    // Step 3: Fetch full data for each unique paper code
    const allPaperCodes = [...new Set([
      ...qpPaperCodes.map(r => r.paper_code),
      ...memoPaperCodes.map(r => r.paper_code)
    ])].sort();

    const allPapers = [];

    for (const paperCode of allPaperCodes) {
      const parsed = parsePaperCode(paperCode);

      // Get QP session data for this paper - JOIN on subject_id (correct)
      const [qpData] = await connection.execute(`
        SELECT 
          ps.subject_id, ps.assessment_body_id, ps.assessment_type_id,
          ps.year_id, ps.grade_id, ps.paper_id,
          ps.total_marks_expected, ps.total_marks_parser, ps.total_marks_corrected,
          ps.total_items_found, ps.status as session_status, ps.parser_version, ps.created_at as session_created_at,
          ls.subject_official_code, ls.subject_name, ls.subject_alpha_code,
          lab.body_code, lab.body_name, lab.body_full_name,
          lat.type_code, lat.type_name,
          ly.year_value, ly.year_label,
          lg.grade_code,
          lp.paper_code as paper_no_code, lp.paper_no
        FROM parse_sessions ps
        LEFT JOIN lookup_subjects ls ON ps.subject_id = ls.subject_id
        LEFT JOIN lookup_assessment_bodies lab ON ps.assessment_body_id = lab.assessment_body_id
        LEFT JOIN lookup_assessment_types lat ON ps.assessment_type_id = lat.assessment_type_id
        LEFT JOIN lookup_years ly ON ps.year_id = ly.year_id
        LEFT JOIN lookup_grades lg ON ps.grade_id = lg.grade_id
        LEFT JOIN lookup_papers lp ON ps.paper_id = lp.paper_id
        WHERE ps.paper_code = ? AND ps.is_memo = 0
        LIMIT 1
      `, [paperCode]);

      // Get Memo session data for this paper
      const [memoData] = await connection.execute(`
        SELECT 
          ps.total_marks_expected, ps.total_marks_parser, ps.total_marks_corrected,
          ps.total_items_found, ps.status as session_status, ps.parser_version, ps.created_at as session_created_at
        FROM parse_sessions ps
        WHERE ps.paper_code = ? AND ps.is_memo = 1
        LIMIT 1
      `, [paperCode]);

      const qpRow = qpData[0] || {};
      const memoRow = memoData[0] || {};
      const hasQp = qpPaperCodes.some(r => r.paper_code === paperCode);
      const hasMemo = memoPaperCodes.some(r => r.paper_code === paperCode);

      allPapers.push({
        paper_code: paperCode,
        display_paper_code: paperCode,
        source: hasQp ? 'qp' : 'memo',
        subject_id: qpRow.subject_id || null,
        subject_official_code: qpRow.subject_official_code || null,
        subject_name: qpRow.subject_name || null,
        subject_alpha_code: qpRow.subject_alpha_code || null,
        subject_code: parsed?.subject_code || null,
        assessment_body_id: qpRow.assessment_body_id || null,
        body_code: qpRow.body_code || null,
        body_name: qpRow.body_name || qpRow.body_full_name || null,
        assessment_type_id: qpRow.assessment_type_id || null,
        type_code: qpRow.type_code || null,
        type_name: qpRow.type_name || null,
        year_id: qpRow.year_id || null,
        year: (parsed?.year ? parseInt(parsed.year) : null) || qpRow.year_value || null,
        grade_id: qpRow.grade_id || null,
        grade: qpRow.grade_code || null,
        paper_id: qpRow.paper_id || null,
        paper_no: qpRow.paper_no || qpRow.paper_no_code || parsed?.paper_no || null,
        language: parsed?.language || null,
        session: parsed?.session || null,
        total_expected_marks: qpRow.total_marks_expected || memoRow.total_marks_expected || null,
        total_qp_marks: hasQp ? (qpRow.total_marks_parser || qpRow.total_marks_corrected) : null,
        total_memo_marks: hasMemo ? (memoRow.total_marks_corrected || memoRow.total_marks_parser) : null,
        total_items_found: qpRow.total_items_found || memoRow.total_items_found || null,
        session_status: qpRow.session_status || memoRow.session_status || null,
        parser_version: qpRow.parser_version || memoRow.parser_version || null,
        session_created_at: qpRow.session_created_at || memoRow.session_created_at || null,
        has_qp: hasQp,
        has_memo: hasMemo
      });
    }

    // Derive filter options from ACTUAL DATA (not lookup tables)
    const filterOptions = {
      subjects: [...new Set(allPapers
        .filter(p => p.subject_official_code || p.subject_alpha_code || p.subject_code)
        .map(p => ({
          value: p.subject_official_code || p.subject_alpha_code || p.subject_code,
          label: p.subject_name || p.subject_alpha_code || p.subject_code,
          official_code: p.subject_official_code,
          alpha_code: p.subject_alpha_code
        }))
      )].filter((s, i, arr) => arr.findIndex(t => t.value === s.value) === i),

      assessment_bodies: [...new Set(allPapers
        .filter(p => p.assessment_body_id && p.body_code)
        .map(p => ({
          value: String(p.assessment_body_id),
          label: p.body_name || p.body_code,
          code: p.body_code
        }))
      )].filter((b, i, arr) => arr.findIndex(t => t.value === b.value) === i),

      assessment_types: [...new Set(allPapers
        .filter(p => p.assessment_type_id && p.type_code)
        .map(p => ({
          value: String(p.assessment_type_id),
          label: p.type_name || p.type_code,
          code: p.type_code
        }))
      )].filter((t, i, arr) => arr.findIndex(x => x.value === t.value) === i),

      years: [...new Set(allPapers
        .filter(p => p.year)
        .map(p => String(p.year))
      )].sort((a, b) => parseInt(b) - parseInt(a)),

      sessions: [...new Set(allPapers
        .filter(p => p.session)
        .map(p => p.session)
      )].sort(),

      languages: [...new Set(allPapers
        .filter(p => p.language)
        .map(p => p.language)
      )].sort(),

      grades: [...new Set(allPapers
        .filter(p => p.grade)
        .map(p => String(p.grade))
      )].sort(),

      paper_nos: [...new Set(allPapers
        .filter(p => p.paper_no)
        .map(p => String(p.paper_no))
      )].sort()
    };

    // Summary counts
    const summary = {
      total_papers: allPapers.length,
      total_expected_marks: allPapers.reduce((sum, p) => sum + (p.total_expected_marks || 0), 0),
      total_qp_marks: allPapers.reduce((sum, p) => sum + (p.total_qp_marks || 0), 0),
      total_memo_marks: allPapers.reduce((sum, p) => sum + (p.total_memo_marks || 0), 0),
      total_items: allPapers.reduce((sum, p) => sum + (p.total_items_found || 0), 0),
      papers_with_qp: allPapers.filter(p => p.has_qp).length,
      papers_with_memo: allPapers.filter(p => p.has_memo).length
    };

    res.json({
      success: true,
      data: allPapers,
      filters: filterOptions,
      summary: summary,
      source: 'parsed'
    });

  } finally {
    connection.release();
  }
}

// ============================================================
// DATABASE DATA - Returns data from item_master + item_memos
// ============================================================
async function getDatabaseData(req, res) {
  const connection = await db.getConnection();

  try {
    // Step 1: Get all distinct paper codes from item_master
    const [dbPaperCodes] = await connection.execute(`
      SELECT DISTINCT source_paper_code as paper_code FROM item_master 
      ORDER BY source_paper_code
    `);

    // Step 2: Fetch full data for each paper code
    const allPapers = [];

    for (const row of dbPaperCodes) {
      const paperCode = row.paper_code;
      const parsed = parsePaperCode(paperCode);

      const [dbItems] = await connection.execute(`
        SELECT 
          im.source_paper_code as paper_code,
          im.subject_id, im.subject_official_code, im.subject_alpha_code,
          im.assessment_body_id, im.assessment_type_id, im.year_id, im.grade_id,
          im.paper_id, im.paper_no, im.language_id,
          im.marks, im.qp_marks, im.memo_marks,
          im.status, im.created_at,
          ls.subject_name,
          lab.body_code, lab.body_name, lab.body_full_name,
          lat.type_code, lat.type_name,
          ly.year_value, ly.year_label,
          lg.grade_code
        FROM item_master im
        LEFT JOIN lookup_subjects ls ON im.subject_id = ls.subject_id
        LEFT JOIN lookup_assessment_bodies lab ON im.assessment_body_id = lab.assessment_body_id
        LEFT JOIN lookup_assessment_types lat ON im.assessment_type_id = lat.assessment_type_id
        LEFT JOIN lookup_years ly ON im.year_id = ly.year_id
        LEFT JOIN lookup_grades lg ON im.grade_id = lg.grade_id
        WHERE im.source_paper_code = ?
        LIMIT 1
      `, [paperCode]);

      const itemRow = dbItems[0] || {};

      allPapers.push({
        paper_code: paperCode,
        display_paper_code: paperCode,
        source: 'database',
        subject_id: itemRow.subject_id || null,
        subject_official_code: itemRow.subject_official_code || null,
        subject_name: itemRow.subject_name || null,
        subject_alpha_code: itemRow.subject_alpha_code || null,
        subject_code: parsed?.subject_code || itemRow.subject_alpha_code || null,
        assessment_body_id: itemRow.assessment_body_id || null,
        body_code: itemRow.body_code || null,
        body_name: itemRow.body_name || itemRow.body_full_name || null,
        assessment_type_id: itemRow.assessment_type_id || null,
        type_code: itemRow.type_code || null,
        type_name: itemRow.type_name || null,
        year_id: itemRow.year_id || null,
        year: (parsed?.year ? parseInt(parsed.year) : null) || itemRow.year_value || null,
        grade_id: itemRow.grade_id || null,
        grade: itemRow.grade_code || null,
        paper_id: itemRow.paper_id || null,
        paper_no: itemRow.paper_no || parsed?.paper_no || null,
        language: parsed?.language || null,
        session: parsed?.session || null,
        total_expected_marks: itemRow.marks || null,
        total_qp_marks: itemRow.qp_marks || null,
        total_memo_marks: itemRow.memo_marks || null,
        total_items_found: null,
        session_status: itemRow.status || null,
        parser_version: null,
        session_created_at: itemRow.created_at || null,
        has_qp: true,
        has_memo: itemRow.memo_marks ? true : false
      });
    }

    // Derive filter options from database data
    const filterOptions = {
      subjects: [...new Set(allPapers
        .filter(p => p.subject_official_code || p.subject_alpha_code || p.subject_code)
        .map(p => ({
          value: p.subject_official_code || p.subject_alpha_code || p.subject_code,
          label: p.subject_name || p.subject_alpha_code || p.subject_code,
          official_code: p.subject_official_code,
          alpha_code: p.subject_alpha_code
        }))
      )].filter((s, i, arr) => arr.findIndex(t => t.value === s.value) === i),

      assessment_bodies: [...new Set(allPapers
        .filter(p => p.assessment_body_id && p.body_code)
        .map(p => ({
          value: String(p.assessment_body_id),
          label: p.body_name || p.body_code,
          code: p.body_code
        }))
      )].filter((b, i, arr) => arr.findIndex(t => t.value === b.value) === i),

      assessment_types: [...new Set(allPapers
        .filter(p => p.assessment_type_id && p.type_code)
        .map(p => ({
          value: String(p.assessment_type_id),
          label: p.type_name || p.type_code,
          code: p.type_code
        }))
      )].filter((t, i, arr) => arr.findIndex(x => x.value === t.value) === i),

      years: [...new Set(allPapers
        .filter(p => p.year)
        .map(p => String(p.year))
      )].sort((a, b) => parseInt(b) - parseInt(a)),

      sessions: [...new Set(allPapers
        .filter(p => p.session)
        .map(p => p.session)
      )].sort(),

      languages: [...new Set(allPapers
        .filter(p => p.language)
        .map(p => p.language)
      )].sort(),

      grades: [...new Set(allPapers
        .filter(p => p.grade)
        .map(p => String(p.grade))
      )].sort(),

      paper_nos: [...new Set(allPapers
        .filter(p => p.paper_no)
        .map(p => String(p.paper_no))
      )].sort()
    };

    const summary = {
      total_papers: allPapers.length,
      total_expected_marks: allPapers.reduce((sum, p) => sum + (p.total_expected_marks || 0), 0),
      total_qp_marks: allPapers.reduce((sum, p) => sum + (p.total_qp_marks || 0), 0),
      total_memo_marks: allPapers.reduce((sum, p) => sum + (p.total_memo_marks || 0), 0),
      total_items: 0,
      papers_with_qp: allPapers.length,
      papers_with_memo: allPapers.filter(p => p.has_memo).length
    };

    res.json({
      success: true,
      data: allPapers,
      filters: filterOptions,
      summary: summary,
      source: 'database'
    });

  } finally {
    connection.release();
  }
}

// GET /api/v2/:paperCode/items - Get items for a paper
router.get('/:paperCode/items', async (req, res) => {
  try {
    const { paperCode } = req.params;
    const source = req.query.source || 'parsed';
    const connection = await db.getConnection();

    try {
      if (source === 'parsed') {
        // Get QP items
        const [qpItems] = await connection.execute(
          `SELECT result_id, paper_code, question_number, question_text, answer_text,
                  expected_marks, parser_extracted_marks, auto_corrected_marks, user_corrected_marks,
                  correction_status, is_header, is_red_flag, parent_header_id, variance,
                  reviewer_notes, parsed_section, parsed_type_id
           FROM parse_results 
           WHERE paper_code = ? AND (is_memo = 0 OR is_memo IS NULL)
           ORDER BY 
             CASE 
               WHEN question_number REGEXP '^[0-9]+\\.[0-9]+\\.[0-9]+$' THEN 3
               WHEN question_number REGEXP '^[0-9]+\\.[0-9]+$' THEN 2
               ELSE 1
             END,
             CAST(SUBSTRING_INDEX(question_number, '.', 1) AS UNSIGNED),
             question_number`,
          [paperCode]
        );

        // Get Memo items
        const [memoItems] = await connection.execute(
          `SELECT memo_id, paper_code, question_number, question_text, answer_text,
                  parser_extracted_marks, auto_corrected_marks, user_corrected_marks,
                  correction_status, is_header, is_red_flag, parent_header_id, variance,
                  reviewer_notes, expected_marks
           FROM parse_memos 
           WHERE paper_code = ?
           ORDER BY 
             CASE 
               WHEN question_number REGEXP '^[0-9]+\\.[0-9]+\\.[0-9]+$' THEN 3
               WHEN question_number REGEXP '^[0-9]+\\.[0-9]+$' THEN 2
               ELSE 1
             END,
             CAST(SUBSTRING_INDEX(question_number, '.', 1) AS UNSIGNED),
             question_number`,
          [paperCode]
        );

        res.json({
          success: true,
          paper_code: paperCode,
          qp_items: qpItems,
          memo_items: memoItems,
          source: 'parsed'
        });
      } else {
        // Database source
        const [dbItems] = await connection.execute(
          `SELECT item_id, source_paper_code, question_number, question_text,
                  marks, qp_marks, memo_marks, status, review_status, is_sub_part,
                  parent_question, created_at, updated_at
           FROM item_master 
           WHERE source_paper_code = ?
           ORDER BY question_number`,
          [paperCode]
        );

        const [dbMemos] = await connection.execute(
          `SELECT im.memo_id, im.item_id, im.question_number, im.answer_text,
                  im.marks, im.marking_guideline, im.version_number, im.is_current
           FROM item_memos im
           JOIN item_master master ON im.item_id = master.item_id
           WHERE master.source_paper_code = ?
           ORDER BY im.question_number`,
          [paperCode]
        );

        res.json({
          success: true,
          paper_code: paperCode,
          qp_items: dbItems,
          memo_items: dbMemos,
          source: 'database'
        });
      }
    } finally {
      connection.release();
    }
  } catch (error) {
    console.error('Error fetching paper items:', error);
    res.status(500).json({ error: 'Failed to fetch paper items', details: error.message });
  }
});

// PUT /api/v2/items/:resultId - Update item marks/status
router.put('/items/:resultId', async (req, res) => {
  try {
    const { resultId } = req.params;
    const { user_corrected_marks, correction_status, reviewer_notes, is_red_flag } = req.body;
    const source = req.query.source || 'parsed';
    const connection = await db.getConnection();

    try {
      if (source === 'parsed') {
        await connection.execute(
          `UPDATE parse_results 
           SET user_corrected_marks = ?, correction_status = ?, reviewer_notes = ?, is_red_flag = ?, updated_at = NOW()
           WHERE result_id = ?`,
          [user_corrected_marks, correction_status, reviewer_notes, is_red_flag ? 1 : 0, resultId]
        );
      } else {
        await connection.execute(
          `UPDATE item_master 
           SET marks = ?, status = ?, updated_at = NOW()
           WHERE item_id = ?`,
          [user_corrected_marks, correction_status, resultId]
        );
      }

      res.json({ success: true, message: 'Item updated successfully' });
    } finally {
      connection.release();
    }
  } catch (error) {
    console.error('Error updating item:', error);
    res.status(500).json({ error: 'Failed to update item', details: error.message });
  }
});

// DELETE /api/v2/items/:resultId - Delete duplicate item
router.delete('/items/:resultId', async (req, res) => {
  try {
    const { resultId } = req.params;
    const source = req.query.source || 'parsed';
    const connection = await db.getConnection();

    try {
      if (source === 'parsed') {
        // Check if this is a duplicate
        const [item] = await connection.execute(
          'SELECT paper_code, question_number FROM parse_results WHERE result_id = ?',
          [resultId]
        );

        if (item.length === 0) {
          return res.status(404).json({ error: 'Item not found' });
        }

        const { paper_code, question_number } = item[0];

        // Count duplicates
        const [duplicates] = await connection.execute(
          'SELECT COUNT(*) as count FROM parse_results WHERE paper_code = ? AND question_number = ? AND (is_memo = 0 OR is_memo IS NULL)',
          [paper_code, question_number]
        );

        if (duplicates[0].count <= 1) {
          return res.status(400).json({ error: 'Cannot delete the only copy of this item' });
        }

        await connection.execute(
          'DELETE FROM parse_results WHERE result_id = ?',
          [resultId]
        );
      } else {
        await connection.execute(
          'DELETE FROM item_master WHERE item_id = ?',
          [resultId]
        );
      }

      res.json({ success: true, message: 'Item deleted successfully' });
    } finally {
      connection.release();
    }
  } catch (error) {
    console.error('Error deleting item:', error);
    res.status(500).json({ error: 'Failed to delete item', details: error.message });
  }
});

module.exports = router;
