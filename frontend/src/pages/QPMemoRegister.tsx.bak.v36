import React, { useState, useEffect, useMemo, useCallback } from 'react';
import { useNavigate } from 'react-router-dom';

// ============================================================
// QP & MEMO REGISTER - SURGICAL FIX v36 FRONTEND
// Date: 2026-06-26
// Changes:
// 1. Cascading filter logic - Subject is root filter
// 2. Filter dropdowns use derived options from data
// 3. Added Paper No filter
// 4. Client-side filtering only (backend returns all data)
// 5. Preserves all existing CRUD functionality
// ============================================================

interface PaperRecord {
  paper_code: string;
  display_paper_code: string;
  source: string;
  subject_id: number | null;
  subject_official_code: string | null;
  subject_name: string | null;
  subject_alpha_code: string | null;
  subject_code: string | null;
  assessment_body_id: number | null;
  body_code: string | null;
  body_name: string | null;
  assessment_type_id: number | null;
  type_code: string | null;
  type_name: string | null;
  year_id: number | null;
  year: number | null;
  grade_id: number | null;
  grade: string | null;
  paper_id: number | null;
  paper_no: string | null;
  language: string | null;
  session: string | null;
  total_expected_marks: number | null;
  total_qp_marks: number | null;
  total_memo_marks: number | null;
  total_items_found: number | null;
  session_status: string | null;
  parser_version: string | null;
  session_created_at: string | null;
  has_qp: boolean;
  has_memo: boolean;
}

interface FilterOption {
  value: string;
  label: string;
  official_code?: string | null;
  alpha_code?: string | null;
  code?: string | null;
}

interface FilterOptions {
  subjects: FilterOption[];
  assessment_bodies: FilterOption[];
  assessment_types: FilterOption[];
  years: string[];
  sessions: string[];
  languages: string[];
  grades: string[];
  paper_nos: string[];
}

interface SummaryData {
  total_papers: number;
  total_expected_marks: number;
  total_qp_marks: number;
  total_memo_marks: number;
  total_items: number;
  papers_with_qp: number;
  papers_with_memo: number;
}

const API_BASE = '/api/v2';

const QPMemoRegister: React.FC = () => {
  const navigate = useNavigate();

  // Data state
  const [data, setData] = useState<PaperRecord[]>([]);
  const [filteredData, setFilteredData] = useState<PaperRecord[]>([]);
  const [filters, setFilters] = useState<FilterOptions | null>(null);
  const [summary, setSummary] = useState<SummaryData | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  // Source toggle
  const [source, setSource] = useState<'parsed' | 'database'>('parsed');

  // Filter selections
  const [selectedSubject, setSelectedSubject] = useState<string>('');
  const [selectedBody, setSelectedBody] = useState<string>('');
  const [selectedType, setSelectedType] = useState<string>('');
  const [selectedYear, setSelectedYear] = useState<string>('');
  const [selectedSession, setSelectedSession] = useState<string>('');
  const [selectedLanguage, setSelectedLanguage] = useState<string>('');
  const [selectedGrade, setSelectedGrade] = useState<string>('');
  const [selectedPaperNo, setSelectedPaperNo] = useState<string>('');
  const [searchTerm, setSearchTerm] = useState<string>('');

  // Expanded paper view
  const [expandedPaper, setExpandedPaper] = useState<string | null>(null);
  const [paperItems, setPaperItems] = useState<any>(null);
  const [itemsLoading, setItemsLoading] = useState(false);

  // Fetch data on mount and when source changes
  useEffect(() => {
    fetchRegisterData();
  }, [source]);

  const fetchRegisterData = async () => {
    setLoading(true);
    setError(null);
    try {
      const response = await fetch(`${API_BASE}/?source=${source}`);
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const result = await response.json();

      if (result.success) {
        setData(result.data || []);
        setFilteredData(result.data || []);
        setFilters(result.filters || null);
        setSummary(result.summary || null);
      } else {
        throw new Error(result.error || 'Unknown error');
      }
    } catch (err: any) {
      setError(err.message);
      console.error('Fetch error:', err);
    } finally {
      setLoading(false);
    }
  };

  // ============================================================
  // CASCADING FILTER LOGIC - Fixed with explicit type predicates
  // ============================================================
  const availableFilters = useMemo(() => {
    const subjectFiltered = selectedSubject
      ? data.filter(r => 
          r.subject_official_code === selectedSubject ||
          r.subject_alpha_code === selectedSubject ||
          r.subject_code === selectedSubject
        )
      : data;

    return {
      subjects: filters?.subjects || [],
      bodies: [...new Set(subjectFiltered.map(r => r.assessment_body_id).filter((id): id is number => id !== null && id !== undefined))].map(id => {
        const paper = subjectFiltered.find(p => p.assessment_body_id === id);
        return {
          value: String(id),
          label: paper?.body_name || paper?.body_code || String(id),
          code: paper?.body_code
        };
      }),
      types: [...new Set(subjectFiltered.map(r => r.assessment_type_id).filter((id): id is number => id !== null && id !== undefined))].map(id => {
        const paper = subjectFiltered.find(p => p.assessment_type_id === id);
        return {
          value: String(id),
          label: paper?.type_name || paper?.type_code || String(id),
          code: paper?.type_code
        };
      }),
      years: [...new Set(subjectFiltered.map(r => r.year).filter((y): y is number => y !== null && y !== undefined))].map(y => String(y)).sort((a, b) => parseInt(b) - parseInt(a)),
      sessions: [...new Set(subjectFiltered.map(r => r.session).filter((s): s is string => s !== null && s !== undefined))].sort(),
      languages: [...new Set(subjectFiltered.map(r => r.language).filter((l): l is string => l !== null && l !== undefined))].sort(),
      grades: [...new Set(subjectFiltered.map(r => r.grade).filter((g): g is string => g !== null && g !== undefined))].map(g => String(g)).sort(),
      paper_nos: [...new Set(subjectFiltered.map(r => r.paper_no).filter((p): p is string => p !== null && p !== undefined))].map(p => String(p)).sort()
    };
  }, [data, selectedSubject, filters]);

  // ============================================================
  // APPLY FILTERS - Client-side only
  // ============================================================
  const applyFilters = useCallback(() => {
    let filtered = [...data];

    // 1. Subject filter first (root)
    if (selectedSubject) {
      filtered = filtered.filter(r => 
        r.subject_official_code === selectedSubject ||
        r.subject_alpha_code === selectedSubject ||
        r.subject_code === selectedSubject
      );
    }

    // 2. All other filters (AND within subject subset)
    if (selectedBody) filtered = filtered.filter(r => r.assessment_body_id === parseInt(selectedBody));
    if (selectedType) filtered = filtered.filter(r => r.assessment_type_id === parseInt(selectedType));
    if (selectedSession) filtered = filtered.filter(r => r.session === selectedSession);
    if (selectedGrade) filtered = filtered.filter(r => String(r.grade) === selectedGrade);
    if (selectedPaperNo) filtered = filtered.filter(r => String(r.paper_no) === selectedPaperNo);
    if (selectedLanguage) filtered = filtered.filter(r => r.language === selectedLanguage);
    if (selectedYear) filtered = filtered.filter(r => String(r.year) === selectedYear);
    if (searchTerm) {
      const term = searchTerm.toLowerCase();
      filtered = filtered.filter(r => 
        (r.display_paper_code || r.paper_code || '').toLowerCase().includes(term) ||
        (r.subject_name || '').toLowerCase().includes(term) ||
        (r.body_name || '').toLowerCase().includes(term)
      );
    }

    setFilteredData(filtered);
  }, [data, selectedSubject, selectedBody, selectedType, selectedSession, selectedGrade, selectedPaperNo, selectedLanguage, selectedYear, searchTerm]);

  // Apply filters whenever any filter changes
  useEffect(() => {
    applyFilters();
  }, [applyFilters]);

  // Reset dependent filters when subject changes
  const handleSubjectChange = (value: string) => {
    setSelectedSubject(value);
    setSelectedBody('');
    setSelectedType('');
    setSelectedYear('');
    setSelectedSession('');
    setSelectedLanguage('');
    setSelectedGrade('');
    setSelectedPaperNo('');
  };

  // Clear all filters
  const clearFilters = () => {
    setSelectedSubject('');
    setSelectedBody('');
    setSelectedType('');
    setSelectedYear('');
    setSelectedSession('');
    setSelectedLanguage('');
    setSelectedGrade('');
    setSelectedPaperNo('');
    setSearchTerm('');
  };

  // Fetch paper items when expanded
  const fetchPaperItems = async (paperCode: string) => {
    if (expandedPaper === paperCode) {
      setExpandedPaper(null);
      setPaperItems(null);
      return;
    }

    setItemsLoading(true);
    try {
      const response = await fetch(`${API_BASE}/${encodeURIComponent(paperCode)}/items?source=${source}`);
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const result = await response.json();

      if (result.success) {
        setPaperItems(result);
        setExpandedPaper(paperCode);
      }
    } catch (err: any) {
      console.error('Error fetching paper items:', err);
    } finally {
      setItemsLoading(false);
    }
  };

  // Delete duplicate item
  const handleDeleteItem = async (resultId: number, paperCode: string) => {
    if (!window.confirm('Are you sure you want to delete this duplicate item?')) return;

    try {
      const response = await fetch(`${API_BASE}/items/${resultId}?source=${source}`, {
        method: 'DELETE'
      });

      if (response.ok) {
        fetchPaperItems(paperCode);
      } else {
        const err = await response.json();
        alert(err.error || 'Failed to delete item');
      }
    } catch (err: any) {
      console.error('Delete error:', err);
      alert('Failed to delete item');
    }
  };

  // Update item marks
  const handleUpdateItem = async (resultId: number, updates: any) => {
    try {
      const response = await fetch(`${API_BASE}/items/${resultId}?source=${source}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(updates)
      });

      if (!response.ok) {
        const err = await response.json();
        alert(err.error || 'Failed to update item');
      }
    } catch (err: any) {
      console.error('Update error:', err);
    }
  };

  // Calculate summary for filtered data
  const filteredSummary = useMemo(() => {
    return {
      total_papers: filteredData.length,
      total_expected_marks: filteredData.reduce((sum, p) => sum + (p.total_expected_marks || 0), 0),
      total_qp_marks: filteredData.reduce((sum, p) => sum + (p.total_qp_marks || 0), 0),
      total_memo_marks: filteredData.reduce((sum, p) => sum + (p.total_memo_marks || 0), 0),
      total_items: filteredData.reduce((sum, p) => sum + (p.total_items_found || 0), 0),
      papers_with_qp: filteredData.filter(p => p.has_qp).length,
      papers_with_memo: filteredData.filter(p => p.has_memo).length
    };
  }, [filteredData]);

  return (
    <div className="qp-memo-register" style={{ padding: '20px' }}>
      <h1>QP & Memo Register</h1>

      {/* Source Toggle */}
      <div style={{ marginBottom: '20px', display: 'flex', gap: '10px', alignItems: 'center' }}>
        <span>Data Source:</span>
        <button 
          onClick={() => setSource('parsed')}
          style={{
            padding: '8px 16px',
            backgroundColor: source === 'parsed' ? '#007bff' : '#e9ecef',
            color: source === 'parsed' ? 'white' : '#333',
            border: 'none',
            borderRadius: '4px',
            cursor: 'pointer'
          }}
        >
          Parsed Data ({summary?.total_papers || 0})
        </button>
        <button 
          onClick={() => setSource('database')}
          style={{
            padding: '8px 16px',
            backgroundColor: source === 'database' ? '#007bff' : '#e9ecef',
            color: source === 'database' ? 'white' : '#333',
            border: 'none',
            borderRadius: '4px',
            cursor: 'pointer'
          }}
        >
          Database ({summary?.total_papers || 0})
        </button>
        <button onClick={fetchRegisterData} style={{ padding: '8px 16px', marginLeft: '10px' }}>
          Refresh
        </button>
      </div>

      {/* Error Display */}
      {error && (
        <div style={{ padding: '10px', backgroundColor: '#f8d7da', color: '#721c24', borderRadius: '4px', marginBottom: '15px' }}>
          Error: {error}
        </div>
      )}

      {/* Filters Section */}
      <div style={{ 
        backgroundColor: '#f8f9fa', 
        padding: '15px', 
        borderRadius: '8px', 
        marginBottom: '20px',
        display: 'grid',
        gridTemplateColumns: 'repeat(auto-fit, minmax(200px, 1fr))',
        gap: '10px'
      }}>
        <div>
          <label style={{ display: 'block', marginBottom: '5px', fontWeight: 'bold' }}>Subject</label>
          <select 
            value={selectedSubject} 
            onChange={(e) => handleSubjectChange(e.target.value)}
            style={{ width: '100%', padding: '8px', borderRadius: '4px', border: '1px solid #ccc' }}
          >
            <option value="">All Subjects</option>
            {filters?.subjects?.map((s) => (
              <option key={s.value} value={s.value}>
                {s.label} ({s.official_code || s.alpha_code || s.value})
              </option>
            ))}
          </select>
        </div>

        <div>
          <label style={{ display: 'block', marginBottom: '5px', fontWeight: 'bold' }}>Assessment Body</label>
          <select 
            value={selectedBody} 
            onChange={(e) => setSelectedBody(e.target.value)}
            disabled={!selectedSubject}
            style={{ width: '100%', padding: '8px', borderRadius: '4px', border: '1px solid #ccc' }}
          >
            <option value="">All Bodies</option>
            {availableFilters.bodies.map((b) => (
              <option key={b.value} value={b.value}>{b.label}</option>
            ))}
          </select>
        </div>

        <div>
          <label style={{ display: 'block', marginBottom: '5px', fontWeight: 'bold' }}>Assessment Type</label>
          <select 
            value={selectedType} 
            onChange={(e) => setSelectedType(e.target.value)}
            disabled={!selectedSubject}
            style={{ width: '100%', padding: '8px', borderRadius: '4px', border: '1px solid #ccc' }}
          >
            <option value="">All Types</option>
            {availableFilters.types.map((t) => (
              <option key={t.value} value={t.value}>{t.label}</option>
            ))}
          </select>
        </div>

        <div>
          <label style={{ display: 'block', marginBottom: '5px', fontWeight: 'bold' }}>Year</label>
          <select 
            value={selectedYear} 
            onChange={(e) => setSelectedYear(e.target.value)}
            disabled={!selectedSubject}
            style={{ width: '100%', padding: '8px', borderRadius: '4px', border: '1px solid #ccc' }}
          >
            <option value="">All Years</option>
            {availableFilters.years.map((y) => (
              <option key={y} value={y}>{y}</option>
            ))}
          </select>
        </div>

        <div>
          <label style={{ display: 'block', marginBottom: '5px', fontWeight: 'bold' }}>Session</label>
          <select 
            value={selectedSession} 
            onChange={(e) => setSelectedSession(e.target.value)}
            disabled={!selectedSubject}
            style={{ width: '100%', padding: '8px', borderRadius: '4px', border: '1px solid #ccc' }}
          >
            <option value="">All Sessions</option>
            {availableFilters.sessions.map((s) => (
              <option key={s} value={s}>{s}</option>
            ))}
          </select>
        </div>

        <div>
          <label style={{ display: 'block', marginBottom: '5px', fontWeight: 'bold' }}>Language</label>
          <select 
            value={selectedLanguage} 
            onChange={(e) => setSelectedLanguage(e.target.value)}
            disabled={!selectedSubject}
            style={{ width: '100%', padding: '8px', borderRadius: '4px', border: '1px solid #ccc' }}
          >
            <option value="">All Languages</option>
            {availableFilters.languages.map((l) => (
              <option key={l} value={l}>{l}</option>
            ))}
          </select>
        </div>

        <div>
          <label style={{ display: 'block', marginBottom: '5px', fontWeight: 'bold' }}>Grade</label>
          <select 
            value={selectedGrade} 
            onChange={(e) => setSelectedGrade(e.target.value)}
            disabled={!selectedSubject}
            style={{ width: '100%', padding: '8px', borderRadius: '4px', border: '1px solid #ccc' }}
          >
            <option value="">All Grades</option>
            {availableFilters.grades.map((g) => (
              <option key={g} value={g}>{g}</option>
            ))}
          </select>
        </div>

        <div>
          <label style={{ display: 'block', marginBottom: '5px', fontWeight: 'bold' }}>Paper No</label>
          <select 
            value={selectedPaperNo} 
            onChange={(e) => setSelectedPaperNo(e.target.value)}
            disabled={!selectedSubject}
            style={{ width: '100%', padding: '8px', borderRadius: '4px', border: '1px solid #ccc' }}
          >
            <option value="">All Papers</option>
            {availableFilters.paper_nos.map((p) => (
              <option key={p} value={p}>{p}</option>
            ))}
          </select>
        </div>

        <div>
          <label style={{ display: 'block', marginBottom: '5px', fontWeight: 'bold' }}>Search</label>
          <input 
            type="text"
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            placeholder="Search paper code..."
            style={{ width: '100%', padding: '8px', borderRadius: '4px', border: '1px solid #ccc' }}
          />
        </div>

        <div style={{ display: 'flex', alignItems: 'flex-end' }}>
          <button 
            onClick={clearFilters}
            style={{ 
              padding: '8px 16px', 
              backgroundColor: '#6c757d', 
              color: 'white', 
              border: 'none', 
              borderRadius: '4px',
              cursor: 'pointer',
              width: '100%'
            }}
          >
            Clear All Filters
          </button>
        </div>
      </div>

      {/* Summary Cards */}
      <div style={{ 
        display: 'grid', 
        gridTemplateColumns: 'repeat(auto-fit, minmax(150px, 1fr))', 
        gap: '10px',
        marginBottom: '20px'
      }}>
        <div style={{ backgroundColor: '#e3f2fd', padding: '15px', borderRadius: '8px', textAlign: 'center' }}>
          <div style={{ fontSize: '24px', fontWeight: 'bold', color: '#1976d2' }}>
            {filteredSummary.total_papers}
          </div>
          <div style={{ fontSize: '12px', color: '#666' }}>Total Papers</div>
        </div>
        <div style={{ backgroundColor: '#e8f5e9', padding: '15px', borderRadius: '8px', textAlign: 'center' }}>
          <div style={{ fontSize: '24px', fontWeight: 'bold', color: '#388e3c' }}>
            {filteredSummary.total_expected_marks}
          </div>
          <div style={{ fontSize: '12px', color: '#666' }}>Expected Marks (PDF)</div>
        </div>
        <div style={{ backgroundColor: '#fff3e0', padding: '15px', borderRadius: '8px', textAlign: 'center' }}>
          <div style={{ fontSize: '24px', fontWeight: 'bold', color: '#f57c00' }}>
            {filteredSummary.total_qp_marks}
          </div>
          <div style={{ fontSize: '12px', color: '#666' }}>QP Marks</div>
        </div>
        <div style={{ backgroundColor: '#fce4ec', padding: '15px', borderRadius: '8px', textAlign: 'center' }}>
          <div style={{ fontSize: '24px', fontWeight: 'bold', color: '#c2185b' }}>
            {filteredSummary.total_memo_marks}
          </div>
          <div style={{ fontSize: '12px', color: '#666' }}>Memo Marks</div>
        </div>
        <div style={{ backgroundColor: '#f3e5f5', padding: '15px', borderRadius: '8px', textAlign: 'center' }}>
          <div style={{ fontSize: '24px', fontWeight: 'bold', color: '#7b1fa2' }}>
            {filteredSummary.total_items}
          </div>
          <div style={{ fontSize: '12px', color: '#666' }}>Total Items</div>
        </div>
      </div>

      {/* Data Table */}
      {loading ? (
        <div style={{ textAlign: 'center', padding: '40px' }}>Loading...</div>
      ) : (
        <div>
          <div style={{ marginBottom: '10px', fontWeight: 'bold' }}>
            Showing {filteredData.length} of {data.length} papers
          </div>

          <table style={{ width: '100%', borderCollapse: 'collapse', backgroundColor: 'white' }}>
            <thead>
              <tr style={{ backgroundColor: '#343a40', color: 'white' }}>
                <th style={{ padding: '10px', textAlign: 'left', border: '1px solid #dee2e6' }}>Paper Code</th>
                <th style={{ padding: '10px', textAlign: 'left', border: '1px solid #dee2e6' }}>Subject</th>
                <th style={{ padding: '10px', textAlign: 'left', border: '1px solid #dee2e6' }}>Body</th>
                <th style={{ padding: '10px', textAlign: 'left', border: '1px solid #dee2e6' }}>Year</th>
                <th style={{ padding: '10px', textAlign: 'left', border: '1px solid #dee2e6' }}>Session</th>
                <th style={{ padding: '10px', textAlign: 'left', border: '1px solid #dee2e6' }}>Lang</th>
                <th style={{ padding: '10px', textAlign: 'center', border: '1px solid #dee2e6' }}>P#</th>
                <th style={{ padding: '10px', textAlign: 'center', border: '1px solid #dee2e6' }}>Expected</th>
                <th style={{ padding: '10px', textAlign: 'center', border: '1px solid #dee2e6' }}>QP</th>
                <th style={{ padding: '10px', textAlign: 'center', border: '1px solid #dee2e6' }}>Memo</th>
                <th style={{ padding: '10px', textAlign: 'center', border: '1px solid #dee2e6' }}>Items</th>
                <th style={{ padding: '10px', textAlign: 'center', border: '1px solid #dee2e6' }}>QP</th>
                <th style={{ padding: '10px', textAlign: 'center', border: '1px solid #dee2e6' }}>Memo</th>
                <th style={{ padding: '10px', textAlign: 'center', border: '1px solid #dee2e6' }}>Actions</th>
              </tr>
            </thead>
            <tbody>
              {filteredData.length === 0 ? (
                <tr>
                  <td colSpan={14} style={{ padding: '20px', textAlign: 'center', color: '#666' }}>
                    No papers found matching the selected filters.
                  </td>
                </tr>
              ) : (
                filteredData.map((paper) => (
                  <React.Fragment key={paper.paper_code}>
                    <tr style={{ borderBottom: '1px solid #dee2e6' }}>
                      <td style={{ padding: '8px', border: '1px solid #dee2e6', fontFamily: 'monospace' }}>
                        {paper.display_paper_code}
                      </td>
                      <td style={{ padding: '8px', border: '1px solid #dee2e6' }}>
                        {paper.subject_name || paper.subject_alpha_code || paper.subject_code || '-'}
                      </td>
                      <td style={{ padding: '8px', border: '1px solid #dee2e6' }}>
                        {paper.body_code || '-'}
                      </td>
                      <td style={{ padding: '8px', border: '1px solid #dee2e6', textAlign: 'center' }}>
                        {paper.year || '-'}
                      </td>
                      <td style={{ padding: '8px', border: '1px solid #dee2e6', textAlign: 'center' }}>
                        {paper.session || '-'}
                      </td>
                      <td style={{ padding: '8px', border: '1px solid #dee2e6', textAlign: 'center' }}>
                        {paper.language || '-'}
                      </td>
                      <td style={{ padding: '8px', border: '1px solid #dee2e6', textAlign: 'center' }}>
                        {paper.paper_no || '-'}
                      </td>
                      <td style={{ padding: '8px', border: '1px solid #dee2e6', textAlign: 'center' }}>
                        {paper.total_expected_marks || 0}
                      </td>
                      <td style={{ padding: '8px', border: '1px solid #dee2e6', textAlign: 'center' }}>
                        {paper.total_qp_marks || 0}
                      </td>
                      <td style={{ padding: '8px', border: '1px solid #dee2e6', textAlign: 'center' }}>
                        {paper.total_memo_marks || 0}
                      </td>
                      <td style={{ padding: '8px', border: '1px solid #dee2e6', textAlign: 'center' }}>
                        {paper.total_items_found || 0}
                      </td>
                      <td style={{ padding: '8px', border: '1px solid #dee2e6', textAlign: 'center' }}>
                        {paper.has_qp ? (
                          <span style={{ color: 'green', fontWeight: 'bold' }}>âœ“</span>
                        ) : (
                          <span style={{ color: '#ccc' }}>âœ—</span>
                        )}
                      </td>
                      <td style={{ padding: '8px', border: '1px solid #dee2e6', textAlign: 'center' }}>
                        {paper.has_memo ? (
                          <span style={{ color: 'green', fontWeight: 'bold' }}>âœ“</span>
                        ) : (
                          <span style={{ color: '#ccc' }}>âœ—</span>
                        )}
                      </td>
                      <td style={{ padding: '8px', border: '1px solid #dee2e6', textAlign: 'center' }}>
                        <button 
                          onClick={() => fetchPaperItems(paper.paper_code)}
                          style={{ padding: '4px 8px', fontSize: '12px', cursor: 'pointer' }}
                        >
                          {expandedPaper === paper.paper_code ? 'Hide' : 'View'}
                        </button>
                      </td>
                    </tr>

                    {/* Expanded Items View */}
                    {expandedPaper === paper.paper_code && paperItems && (
                      <tr>
                        <td colSpan={14} style={{ padding: '0', border: '1px solid #dee2e6', backgroundColor: '#f8f9fa' }}>
                          <div style={{ padding: '15px' }}>
                            <h4>Items for {paper.paper_code}</h4>

                            {itemsLoading ? (
                              <div>Loading items...</div>
                            ) : (
                              <div>
                                {/* QP Items */}
                                {paperItems.qp_items && paperItems.qp_items.length > 0 && (
                                  <div style={{ marginBottom: '15px' }}>
                                    <h5 style={{ color: '#1976d2' }}>Question Paper Items ({paperItems.qp_items.length})</h5>
                                    <table style={{ width: '100%', fontSize: '13px', borderCollapse: 'collapse' }}>
                                      <thead>
                                        <tr style={{ backgroundColor: '#e3f2fd' }}>
                                          <th style={{ padding: '6px', border: '1px solid #bbdefb' }}>Q#</th>
                                          <th style={{ padding: '6px', border: '1px solid #bbdefb' }}>Question</th>
                                          <th style={{ padding: '6px', border: '1px solid #bbdefb', textAlign: 'center' }}>Expected</th>
                                          <th style={{ padding: '6px', border: '1px solid #bbdefb', textAlign: 'center' }}>Parsed</th>
                                          <th style={{ padding: '6px', border: '1px solid #bbdefb', textAlign: 'center' }}>Corrected</th>
                                          <th style={{ padding: '6px', border: '1px solid #bbdefb', textAlign: 'center' }}>Status</th>
                                          <th style={{ padding: '6px', border: '1px solid #bbdefb', textAlign: 'center' }}>Header</th>
                                          <th style={{ padding: '6px', border: '1px solid #bbdefb', textAlign: 'center' }}>Actions</th>
                                        </tr>
                                      </thead>
                                      <tbody>
                                        {paperItems.qp_items.map((item: any) => (
                                          <tr key={item.result_id} style={{ 
                                            backgroundColor: item.is_header ? '#fff8e1' : 'white',
                                            borderBottom: '1px solid #bbdefb'
                                          }}>
                                            <td style={{ padding: '6px', border: '1px solid #bbdefb', fontWeight: item.is_header ? 'bold' : 'normal' }}>
                                              {item.question_number}
                                            </td>
                                            <td style={{ padding: '6px', border: '1px solid #bbdefb', maxWidth: '300px', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                                              {item.question_text ? item.question_text.substring(0, 80) + '...' : '-'}
                                            </td>
                                            <td style={{ padding: '6px', border: '1px solid #bbdefb', textAlign: 'center' }}>
                                              {item.expected_marks || 0}
                                            </td>
                                            <td style={{ padding: '6px', border: '1px solid #bbdefb', textAlign: 'center' }}>
                                              {item.parser_extracted_marks || 0}
                                            </td>
                                            <td style={{ padding: '6px', border: '1px solid #bbdefb', textAlign: 'center' }}>
                                              <input 
                                                type="number"
                                                defaultValue={item.user_corrected_marks || item.auto_corrected_marks || 0}
                                                onBlur={(e) => handleUpdateItem(item.result_id, { 
                                                  user_corrected_marks: parseInt(e.target.value) || 0,
                                                  correction_status: 'corrected'
                                                })}
                                                style={{ width: '50px', textAlign: 'center' }}
                                              />
                                            </td>
                                            <td style={{ padding: '6px', border: '1px solid #bbdefb', textAlign: 'center' }}>
                                              <span style={{
                                                padding: '2px 6px',
                                                borderRadius: '4px',
                                                fontSize: '11px',
                                                backgroundColor: item.correction_status === 'corrected' ? '#e8f5e9' : '#fff3e0',
                                                color: item.correction_status === 'corrected' ? '#2e7d32' : '#ef6c00'
                                              }}>
                                                {item.correction_status || 'pending'}
                                              </span>
                                            </td>
                                            <td style={{ padding: '6px', border: '1px solid #bbdefb', textAlign: 'center' }}>
                                              {item.is_header ? (
                                                <span style={{ color: '#f57c00', fontWeight: 'bold' }}>H</span>
                                              ) : (
                                                <span style={{ color: '#ccc' }}>-</span>
                                              )}
                                            </td>
                                            <td style={{ padding: '6px', border: '1px solid #bbdefb', textAlign: 'center' }}>
                                              <button 
                                                onClick={() => handleDeleteItem(item.result_id, paper.paper_code)}
                                                style={{ 
                                                  padding: '2px 6px', 
                                                  fontSize: '11px', 
                                                  backgroundColor: '#dc3545', 
                                                  color: 'white',
                                                  border: 'none',
                                                  borderRadius: '3px',
                                                  cursor: 'pointer'
                                                }}
                                              >
                                                Delete
                                              </button>
                                            </td>
                                          </tr>
                                        ))}
                                      </tbody>
                                    </table>
                                  </div>
                                )}

                                {/* Memo Items */}
                                {paperItems.memo_items && paperItems.memo_items.length > 0 && (
                                  <div>
                                    <h5 style={{ color: '#c2185b' }}>Memo Items ({paperItems.memo_items.length})</h5>
                                    <table style={{ width: '100%', fontSize: '13px', borderCollapse: 'collapse' }}>
                                      <thead>
                                        <tr style={{ backgroundColor: '#fce4ec' }}>
                                          <th style={{ padding: '6px', border: '1px solid #f8bbd0' }}>Q#</th>
                                          <th style={{ padding: '6px', border: '1px solid #f8bbd0' }}>Answer</th>
                                          <th style={{ padding: '6px', border: '1px solid #f8bbd0', textAlign: 'center' }}>Marks</th>
                                          <th style={{ padding: '6px', border: '1px solid #f8bbd0', textAlign: 'center' }}>Corrected</th>
                                          <th style={{ padding: '6px', border: '1px solid #f8bbd0', textAlign: 'center' }}>Status</th>
                                          <th style={{ padding: '6px', border: '1px solid #f8bbd0', textAlign: 'center' }}>Header</th>
                                        </tr>
                                      </thead>
                                      <tbody>
                                        {paperItems.memo_items.map((item: any) => (
                                          <tr key={item.memo_id} style={{ 
                                            backgroundColor: item.is_header ? '#fff8e1' : 'white',
                                            borderBottom: '1px solid #f8bbd0'
                                          }}>
                                            <td style={{ padding: '6px', border: '1px solid #f8bbd0', fontWeight: item.is_header ? 'bold' : 'normal' }}>
                                              {item.question_number}
                                            </td>
                                            <td style={{ padding: '6px', border: '1px solid #f8bbd0', maxWidth: '300px', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                                              {item.answer_text ? item.answer_text.substring(0, 80) + '...' : '-'}
                                            </td>
                                            <td style={{ padding: '6px', border: '1px solid #f8bbd0', textAlign: 'center' }}>
                                              {item.parser_extracted_marks || 0}
                                            </td>
                                            <td style={{ padding: '6px', border: '1px solid #f8bbd0', textAlign: 'center' }}>
                                              <input 
                                                type="number"
                                                defaultValue={item.user_corrected_marks || item.auto_corrected_marks || 0}
                                                onBlur={(e) => handleUpdateItem(item.memo_id, { 
                                                  user_corrected_marks: parseInt(e.target.value) || 0,
                                                  correction_status: 'corrected'
                                                })}
                                                style={{ width: '50px', textAlign: 'center' }}
                                              />
                                            </td>
                                            <td style={{ padding: '6px', border: '1px solid #f8bbd0', textAlign: 'center' }}>
                                              <span style={{
                                                padding: '2px 6px',
                                                borderRadius: '4px',
                                                fontSize: '11px',
                                                backgroundColor: item.correction_status === 'corrected' ? '#e8f5e9' : '#fff3e0',
                                                color: item.correction_status === 'corrected' ? '#2e7d32' : '#ef6c00'
                                              }}>
                                                {item.correction_status || 'pending'}
                                              </span>
                                            </td>
                                            <td style={{ padding: '6px', border: '1px solid #f8bbd0', textAlign: 'center' }}>
                                              {item.is_header ? (
                                                <span style={{ color: '#f57c00', fontWeight: 'bold' }}>H</span>
                                              ) : (
                                                <span style={{ color: '#ccc' }}>-</span>
                                              )}
                                            </td>
                                          </tr>
                                        ))}
                                      </tbody>
                                    </table>
                                  </div>
                                )}

                                {(!paperItems.qp_items || paperItems.qp_items.length === 0) && 
                                 (!paperItems.memo_items || paperItems.memo_items.length === 0) && (
                                  <div style={{ padding: '20px', textAlign: 'center', color: '#666' }}>
                                    No items found for this paper.
                                  </div>
                                )}
                              </div>
                            )}
                          </div>
                        </td>
                      </tr>
                    )}
                  </React.Fragment>
                ))
              )}
            </tbody>
          </table>
        </div>
      )}
    </div>
  );
};

export default QPMemoRegister;
